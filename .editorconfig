# EditorConfig gives every editor the same basic rules (VS Code: install the "EditorConfig" extension).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown: keep them.
trim_trailing_whitespace = false

[*.{csv,tsv}]
# Café data: never change a value, not even trailing spaces.
trim_trailing_whitespace = false
