# .gitignore: files Git must never track in this PUBLIC repository.
# Rule of thumb: no secrets, no personal data, no real café data, no generated files.
# See docs/operations/secrets.md.

# --- Dependencies (re-created by `npm ci` from package-lock.json) ---
node_modules/

# --- Build, test and coverage output ---
dist/
coverage/
test-results/
playwright-report/
blob-report/
*.tsbuildinfo
*.tgz

# --- Cloudflare Wrangler local state (local D1 database, Durable Object storage) ---
.wrangler/

# --- Secrets and local settings: NEVER commit these ---
# Local Worker secrets for `wrangler dev`. Commit only the .example file with fake values.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
# Private keys and certificates (including the offline age backup key).
*.pem
*.key
*.p12
*.pfx
*.agekey

# --- Database files and exports (may contain personal data, D-027) ---
*.sqlite
*.sqlite3
*.db
/backups/

# --- Real café data lives only in the PRIVATE deploy repo (D-022, NFR-12) ---
# Public: the fictional demo café, the test fixtures and the onboarding template.
# Any other folder created under cafes/ (for example a real café) is ignored.
/cafes/*
!/cafes/README.md
!/cafes/demo/
!/cafes/_fixtures/
!/cafes/_template/

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- Operating system and editor files ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
